        "chapterId": "MATH-VN-C01-vector_trong_khong_gian_",
        "title": "Hệ số chiếu lên một vector",
        "formula": "α = (u·x)/(u·u)",
        "meaning": "α là hệ số scalar cho biết phải nhân vector u bao nhiêu lần để lấy thành phần của x theo hướng u.",
        "conditions": [
          "u khác vector 0.",
          "x và u ở cùng không gian tọa độ."
        ],
        "commonMistakes": [
          "Dùng α=u·x khi u chưa được chuẩn hóa.",
          "Quên mẫu u·u khi u không phải unit vector."
        ],
        "programmingUse": "alpha = dot(u,x)/dot(u,u); kiểm dot(u,u) không gần 0.",
        "tags": [
          "projection",
          "dot-product",
          "vector"
        ],
        "auditStatus": "PASS",
        "sourceBundle": "E185_ORTHOGONAL_PROJECTION"
      },
      {
        "formulaId": "E185-proj-F2",
        "lessonId": "MATH-VN-LA-C01-L06",
        "chapterId": "MATH-VN-C01-vector_trong_khong_gian_",
        "title": "Projection vector",
        "formula": "proj_u(x) = ((u·x)/(u·u))u",
        "meaning": "Projection là thành phần của x song song với span{u}; residual x-proj_u(x) trực giao với u.",
        "conditions": [
          "u≠0.",
          "Inner product dùng nhất quán."
        ],
        "commonMistakes": [
          "Nhầm hệ số projection với projection vector.",
          "Dùng u đơn vị giả định mà không kiểm norm."
        ],
        "programmingUse": "p = (u @ x)/(u @ u) * u.",
        "tags": [
          "projection",
          "orthogonal",
          "residual"
        ],
        "auditStatus": "PASS",
        "sourceBundle": "E185_ORTHOGONAL_PROJECTION"
      },
