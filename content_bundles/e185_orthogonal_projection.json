        "formulaId": "E185-proj-F3",
        "lessonId": "MATH-VN-LA-C01-L06",
        "chapterId": "MATH-VN-C01-vector_trong_khong_gian_",
        "title": "Phân rã song song và vuông góc",
        "formula": "x = x∥ + x⊥,  x∥=proj_u(x),  u·x⊥=0",
        "meaning": "Mọi vector x được tách thành phần theo hướng u và phần dư vuông góc với u.",
        "conditions": [
          "u≠0.",
          "Không gian Euclid hữu hạn chiều trong bài này."
        ],
        "commonMistakes": [
          "Cho rằng residual nhỏ nghĩa là projection đúng nếu u bị scale sai.",
          "Nhầm x⊥ với vector 0."
        ],
        "programmingUse": "r = x - p; kiểm abs(dot(u,r))/(norm(u)*max(norm(r),eps)) nhỏ.",
        "tags": [
          "decomposition",
          "projection",
          "orthogonality"
        ],
        "auditStatus": "PASS",
        "sourceBundle": "E185_ORTHOGONAL_PROJECTION"
      }
