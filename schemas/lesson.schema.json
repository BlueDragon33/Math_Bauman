{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stageId",
          "partId",
          "title",
          "learningObjectives",
          "conceptIds",
          "examTags",
          "applications"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stageId": {
            "type": "string"
          },
          "partId": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "learningObjectives": {
            "type": "array"
          },
          "conceptIds": {
            "type": "array"
          },
          "examTags": {
            "type": "array"
          },
          "applications": {
            "type": "array"
          }
        }
      }
    }
  }
}